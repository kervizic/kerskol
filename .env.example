# Modele de configuration. Sur le VPS, le fichier reel /opt/kerskol/.env est
# genere par deploy/gen-secrets.sh (secrets techniques) puis complete a la main
# (Google OAuth + Gmail). Ne JAMAIS committer de .env reel.
# Ce fichier ne contient QUE des placeholders (vides ou CHANGEME).

# --- PostgreSQL ---
POSTGRES_PASSWORD=CHANGEME

# --- JWT / cles Supabase ---
# ANON_KEY et SERVICE_ROLE_KEY sont des JWT HS256 signes avec JWT_SECRET
# (generes automatiquement par gen-secrets.sh).
JWT_SECRET=CHANGEME
ANON_KEY=CHANGEME
SERVICE_ROLE_KEY=CHANGEME

# --- Role technique du mailer (privileges minimaux) ---
KERSKOL_MAILER_PASSWORD=CHANGEME

# --- URLs publiques ---
SITE_URL=https://kerskol.fr
API_EXTERNAL_URL=https://kerskol.fr

# --- Authentification Google (parent uniquement) ---
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=CHANGEME
GOTRUE_EXTERNAL_GOOGLE_SECRET=CHANGEME

# --- Envoi de mails aux parents via Gmail (OAuth2, scope gmail.send) ---
GMAIL_CLIENT_ID=CHANGEME
GMAIL_CLIENT_SECRET=CHANGEME
GMAIL_REFRESH_TOKEN=CHANGEME
MAIL_FROM=CHANGEME
MAIL_FROM_NAME=Kerskol

# --- Reglages optionnels du mailer ---
MAILER_POLL_INTERVAL_MS=60000
MAILER_MAX_ATTEMPTS=5
