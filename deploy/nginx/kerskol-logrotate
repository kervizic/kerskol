# Rotation des logs nginx de kerskol : retention 7 jours (RGPD).
# A installer : sudo cp deploy/nginx/kerskol-logrotate /etc/logrotate.d/kerskol
#
# Les logs kerskol vivent dans /var/log/nginx/kerskol/ : ce sous-repertoire
# n'est PAS capte par le glob global /var/log/nginx/*.log, donc kertec n'est
# pas affecte et il n'y a pas de double rotation.
/var/log/nginx/kerskol/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 $(cat /var/run/nginx.pid)
    endscript
}
