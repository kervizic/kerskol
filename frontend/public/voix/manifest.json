    },
    "710b7e1c2e26848e": {
      "text": "À toi de jouer.",
      "ms": 1200,
      "cat": "consigne"
    },
    "f9c4a73985ca4e7c": {
      "text": "Lis bien la consigne.",
      "ms": 960,
      "cat": "consigne"
    },
    "1072ff19ad06d115": {
      "text": "Prends ton temps.",
      "ms": 1120,
      "cat": "consigne"
    },
    "c9bda05b4d21b495": {
      "text": "C'est parti !",
      "ms": 560,
      "cat": "consigne"
    },
    "c66f42226c3e3596": {
      "text": "Bravo ! C'est la bonne réponse.",
      "ms": 1760,
      "cat": "message"
    },
    "8f3c5d21e3d2e2dc": {
      "text": "Ce n'est pas tout à fait ça. Regarde bien et essaie encore.",
      "ms": 4800,
      "cat": "message"
    },
    "d1ee0862eec1c469": {
      "text": "Super détective ! Tu as trouvé tous les mots piégés.",
      "ms": 3440,
      "cat": "message"
    },
    "696a07048851d291": {
      "text": "Jamais de s à mille. Mille ne change jamais.",
      "ms": 3040,
      "cat": "message"
    },
    "4c57de4a4fa8eae7": {
      "text": "Vérifie bien ta réponse avant de valider.",
      "ms": 1840,
      "cat": "message"
    },
    "0f681da1263bca25": {
      "text": "Le chat et le chien sont dans le jardin.",
      "ms": 1920,
      "cat": "dictee"
    },
    "6c0f97217eeb1807": {
      "text": "On joue avec eux tous les jours.",
      "ms": 1520,
      "cat": "dictee"
    },
    "16c9c746d94816e2": {
      "text": "Dans la forêt, les feuilles tombent doucement.",
      "ms": 2240,
      "cat": "dictee"
    },
    "76776ea8a23360f1": {
      "text": "Elles sont jaunes et rouges.",
      "ms": 1200,
      "cat": "dictee"
    },
    "234d4206d8bb8737": {
      "text": "Les oiseaux sont partis vers le sud.",
      "ms": 1840,
